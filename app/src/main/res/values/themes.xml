<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Launch theme only. The in-app colours come from Compose (HanumanChalisaTheme); this exists so
        the window background matches the app while the activity starts, avoiding a white flash.
    -->
    <style name="Theme.HanumanChalisaCounter" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/warm_surface</item>
        <item name="android:statusBarColor">@color/saffron_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
