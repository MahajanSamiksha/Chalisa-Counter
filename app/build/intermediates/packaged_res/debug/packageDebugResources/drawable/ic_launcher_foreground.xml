<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher foreground: a stylised gada (mace), Hanuman's emblem, drawn as a vector so the icon
    needs no bitmap assets at any density. Artwork is kept inside the adaptive-icon safe zone
    (the middle ~66dp of the 108dp canvas).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Handle -->
    <path
        android:fillColor="#FFF3E0"
        android:pathData="M50.5,60 h7 a2,2 0 0 1 2,2 v20 a3.5,3.5 0 0 1 -3.5,3.5 h-4 a3.5,3.5 0 0 1 -3.5,-3.5 v-20 a2,2 0 0 1 2,-2 z" />

    <!-- Grip rings -->
    <path
        android:fillColor="#B35400"
        android:pathData="M48.5,66 h11 v2.6 h-11 z M48.5,72 h11 v2.6 h-11 z M48.5,78 h11 v2.6 h-11 z" />

    <!-- Mace head -->
    <path
        android:fillColor="#FFF3E0"
        android:pathData="M54,22 m-17,0 a17,17 0 1 0 34,0 a17,17 0 1 0 -34,0 z" />

    <!-- Collar between head and handle -->
    <path
        android:fillColor="#B35400"
        android:pathData="M45,38 h18 a2.5,2.5 0 0 1 2.5,2.5 v4 a2.5,2.5 0 0 1 -2.5,2.5 h-18 a2.5,2.5 0 0 1 -2.5,-2.5 v-4 a2.5,2.5 0 0 1 2.5,-2.5 z" />

    <!-- Second collar band -->
    <path
        android:fillColor="#B35400"
        android:pathData="M47.5,49.5 h13 a2,2 0 0 1 2,2 v3 a2,2 0 0 1 -2,2 h-13 a2,2 0 0 1 -2,-2 v-3 a2,2 0 0 1 2,-2 z" />

    <!-- Highlight on the head -->
    <path
        android:fillColor="#FFD9A0"
        android:pathData="M47,15 a8,8 0 0 1 8,-5.5 a10,10 0 0 0 -10,10 a8,8 0 0 1 2,-4.5 z" />
</vector>
