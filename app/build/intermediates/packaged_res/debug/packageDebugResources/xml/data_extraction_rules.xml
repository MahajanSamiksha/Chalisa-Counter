<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12 and above. The counts database (plus its
    write-ahead log sidecars) is included in both cloud backup and device-to-device transfer, so the
    practice history follows you to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="hanuman_chalisa.db" />
        <include
            domain="database"
            path="hanuman_chalisa.db-wal" />
        <include
            domain="database"
            path="hanuman_chalisa.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="hanuman_chalisa.db" />
        <include
            domain="database"
            path="hanuman_chalisa.db-wal" />
        <include
            domain="database"
            path="hanuman_chalisa.db-shm" />
    </device-transfer>
</data-extraction-rules>
