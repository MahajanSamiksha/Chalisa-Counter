<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 11 and below. The counts database is included, so if you ever restore
    this app onto a new phone from a backup, your practice history comes with it.

    Room enables write-ahead logging, so the -wal and -shm sidecar files are included too — backing
    up the .db alone could otherwise miss the most recent counts.
-->
<full-backup-content>
    <include
        domain="database"
        path="hanuman_chalisa.db" />
    <include
        domain="database"
        path="hanuman_chalisa.db-wal" />
    <include
        domain="database"
        path="hanuman_chalisa.db-shm" />
</full-backup-content>
