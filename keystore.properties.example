# Copy this file to `keystore.properties` and fill in your own values.
#
# `keystore.properties` and *.jks are gitignored. Never commit either one.
# Back up your keystore somewhere safe: if you lose it, you cannot publish an
# update that existing users can install over their copy of the app.
#
# Generate the keystore with (choose your own password when prompted):
#
#   keytool -genkeypair -v -keystore chalisa-release.jks \
#     -alias chalisa -keyalg RSA -keysize 4096 -validity 10000
#
# Path is resolved relative to the repository root.
storeFile=chalisa-release.jks
storePassword=
keyAlias=chalisa
keyPassword=
