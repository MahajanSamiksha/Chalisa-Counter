# Normalize to LF in the repository; let Git decide the working-copy ending.
* text=auto

# These must keep LF even when checked out on Windows: the Gradle wrapper script
# and the CI workflows run on Linux, where CRLF breaks the shebang line.
gradlew        text eol=lf
*.sh           text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf

# Windows-only script.
gradlew.bat    text eol=crlf

# Binary: never touch line endings, never try to diff.
*.jar          binary
*.png          binary
*.jks          binary
*.keystore     binary
*.apk          binary
