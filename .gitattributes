# Normalize to LF in the repository; let Git decide the working-copy ending.
* text=auto

# These must keep LF even when checked out on Windows: shell scripts run on
# Linux and macOS, where a CRLF shebang line breaks execution. Keeping the yml
# rules means CI config added later is correct from the first commit.
gradlew        text eol=lf
*.sh           text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf

# Windows-only script.
gradlew.bat    text eol=crlf

# Binary: never touch line endings, never try to diff.
*.jar          binary
*.png          binary
*.jks          binary
*.keystore     binary
*.apk          binary
